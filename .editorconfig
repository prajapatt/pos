root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml,c,h,md,txt,yml,yaml,json}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,py}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
